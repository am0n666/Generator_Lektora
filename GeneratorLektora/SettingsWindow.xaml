<Window x:Class="GeneratorLektora.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ustawienia" Width="620" Height="700" MinWidth="540" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBrush}" ShowInTaskbar="False">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Ustawienia" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock Text="Skonfiguruj głos, jakość syntezy i sposób dopasowania lektora do filmu." Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="0,5,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,22,0,18" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Głos i jakość" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Wybierz głos Supertonic oraz liczbę kroków syntezy." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,4,0,16"/>
                        <TextBlock Text="GŁOS" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="VoiceBox" Grid.Column="0">
                                <ComboBoxItem Tag="M1" Content="M1  •  męski"/><ComboBoxItem Tag="M2" Content="M2  •  męski"/>
                                <ComboBoxItem Tag="M3" Content="M3  •  męski  •  domyślny"/><ComboBoxItem Tag="M4" Content="M4  •  męski"/>
                                <ComboBoxItem Tag="M5" Content="M5  •  męski"/><ComboBoxItem Tag="F1" Content="F1  •  żeński"/>
                                <ComboBoxItem Tag="F2" Content="F2  •  żeński"/><ComboBoxItem Tag="F3" Content="F3  •  żeński"/>
                                <ComboBoxItem Tag="F4" Content="F4  •  żeński"/><ComboBoxItem Tag="F5" Content="F5  •  żeński"/>
                            </ComboBox>
                            <Button Grid.Column="1" Content="▶  Testuj głos" Width="125" Margin="10,0,0,0" Click="TestVoice_Click"/>
                        </Grid>
                        <TextBlock Text="JAKOŚĆ (STEPS)" Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
                        <ComboBox x:Name="StepsBox">
                            <ComboBoxItem Tag="5" Content="5  •  szybka synteza"/><ComboBoxItem Tag="8" Content="8  •  standard"/>
                            <ComboBoxItem Tag="12" Content="12  •  wysoka jakość"/><ComboBoxItem Tag="16" Content="16  •  maksymalna jakość"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="Dopasowanie tempa" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Generator najpierw tworzy mowę z bazową prędkością, a następnie przyspiesza ją tylko wtedy, gdy wymaga tego dostępne miejsce między dialogami." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,4,0,16" TextWrapping="Wrap"/>
                        <TextBlock Text="BAZOWE TEMPO" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="BaseSpeedBox" ToolTip="Zakres 0,85–1,30"/>
                        <TextBlock Text="MAKSYMALNE TEMPO DOPASOWANIA" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                        <TextBox x:Name="MaxSpeedBox" ToolTip="Zakres 1,00–1,60"/>
                        <TextBlock Text="Zakres bazowego tempa: 0,85–1,30. Maksymalne tempo: 1,00–1,60." Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,6,0,0"/>
                        <Separator Margin="0,18,0,14"/>
                        <CheckBox x:Name="SmartPausesBox" Content="Inteligentne pauzy między kwestiami"/>
                        <TextBlock Text="Generator dobiera długość pauzy do zakończenia zdania (np. kropka, pytajnik, wykrzyknik, wielokropek), ale skraca ją automatycznie, gdy synchronizacja filmu tego wymaga." Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,6,0,12" TextWrapping="Wrap"/>
                        <TextBlock Text="MINIMALNA PAUZA" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                        <TextBox x:Name="MinPauseBox" ToolTip="Zakres 0,08–0,50 s"/>
                        <TextBlock Text="Wartość domyślna: 0,20 s. Algorytm traktuje ją jako bezpieczną minimalną przerwę, a po kropce, pytajniku, wykrzykniku lub wielokropku może zostawić więcej ciszy. Jeśli dialog jest bardzo ciasny, pauza jest automatycznie skracana, aby zachować synchronizację." Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="Ducking oryginalnego audio" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Automatycznie ścisza oryginalną ścieżkę, gdy lektor mówi, aby poprawić czytelność narracji." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,4,0,12" TextWrapping="Wrap"/>
                        <CheckBox x:Name="NoDuckBox" Content="Nie przyciszaj oryginalnego audio podczas mowy"/>
                        <TextBlock Text="PRÓG DUCKINGU" Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
                        <TextBox x:Name="DuckThresholdBox" ToolTip="Zakres 0,01–0,20"/>
                        <TextBlock Text="Niższa wartość oznacza wcześniejsze uruchamianie przyciszania oryginalnego audio." Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,18,0,0">
            <Grid>
                <Button Content="Przywróć domyślne" HorizontalAlignment="Left" Width="145" Click="Defaults_Click"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Anuluj" Width="96" Click="Cancel_Click"/>
                    <Button Content="Zapisz ustawienia" Width="145" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
