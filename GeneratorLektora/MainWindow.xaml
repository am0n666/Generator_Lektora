<Window x:Class="GeneratorLektora.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Generator Lektora" Width="1180" Height="760" MinWidth="980" MinHeight="650" Background="#0F1624" Foreground="{DynamicResource Text}"><Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Generator Lektora" FontSize="30" FontWeight="Bold"/><TextBlock Text="Polski lektor AI • obsługa MKV, SRT, TTS i miksowania audio" Foreground="#9EABC2" Margin="0,4,0,18"/></StackPanel><Border Grid.Row="1" Background="{DynamicResource Panel}" CornerRadius="10" Padding="14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0"><TextBlock Text="Plik wejściowy MKV"/><DockPanel><TextBox x:Name="InputBox" Height="32"/><Button Content="Wybierz…" Click="Input_Click"/></DockPanel></StackPanel><StackPanel Grid.Column="1" Margin="10,0"><TextBlock Text="Napisy SRT (opcjonalnie)"/><DockPanel><TextBox x:Name="SrtBox" Height="32"/><Button Content="Wybierz…" Click="Srt_Click"/></DockPanel></StackPanel><StackPanel Grid.Column="2" Margin="10,0,0,0"><TextBlock Text="Plik wyjściowy MKV"/><DockPanel><TextBox x:Name="OutputBox" Height="32"/><Button Content="Wybierz…" Click="Output_Click"/></DockPanel></StackPanel></Grid></Border><Grid Grid.Row="2" Margin="0,18,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="{DynamicResource Panel}" CornerRadius="10" Padding="16" Margin="0,0,10,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Konfiguracja" FontSize="20" FontWeight="SemiBold"/><Grid Grid.Row="1" Margin="0,15"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Silnik TTS" VerticalAlignment="Center"/><ComboBox x:Name="EngineBox" Grid.Column="1" SelectedIndex="0"><ComboBoxItem Content="Supertonic 3 (lokalny)" Tag="supertonic"/><ComboBoxItem Content="Microsoft Edge TTS (online)" Tag="edge"/></ComboBox><TextBlock Grid.Column="2" Text="Głos" VerticalAlignment="Center" Margin="20,0,5,0"/><TextBox x:Name="VoiceBox" Grid.Column="3" Text="M3"/></Grid><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Kodek" VerticalAlignment="Center"/><ComboBox x:Name="CodecBox" Grid.Column="1" SelectedIndex="0"><ComboBoxItem Content="FLAC"/><ComboBoxItem Content="PCM"/><ComboBoxItem Content="AAC"/><ComboBoxItem Content="Opus"/></ComboBox><TextBlock Grid.Column="2" Text="Głośność podkładu" VerticalAlignment="Center" Margin="20,0,5,0"/><Slider x:Name="DuckSlider" Grid.Column="3" Minimum="-18" Maximum="0" Value="-8"/></Grid><WrapPanel Grid.Row="3" Margin="0,15,0,8"><CheckBox x:Name="DuckingBox" Content="Automatyczne ściszanie oryginału (ducking)" IsChecked="True" Margin="4"/><CheckBox x:Name="NumbersBox" Content="Rozwijaj liczby" IsChecked="True" Margin="18,4"/><CheckBox x:Name="SdhBox" Content="Usuwaj SDH/muzykę" IsChecked="True" Margin="18,4"/></WrapPanel><TextBlock Grid.Row="4" Text="Ustawienia odpowiadają parametrom skryptu lektor.cmd. Wersja GUI wykonuje operacje bez uruchamiania konsoli Windows." Foreground="#9EABC2" TextWrapping="Wrap" VerticalAlignment="Bottom"/></Grid></Border><Border Grid.Column="1" Background="{DynamicResource Panel}" CornerRadius="10" Padding="16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Informacje" FontSize="20" FontWeight="SemiBold"/><Button Grid.Row="1" Content="Analizuj plik" Click="Analyze_Click" HorizontalAlignment="Left" Margin="0,14,0,10"/><ListBox x:Name="TracksList" Grid.Row="2" Background="#111827" Foreground="White" BorderThickness="0"/></Grid></Border></Grid><Border Grid.Row="3" Background="{DynamicResource Panel}" CornerRadius="10" Padding="12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ProgressBar x:Name="Progress" Height="14" Minimum="0" Maximum="100"/><DockPanel Grid.Row="1" Margin="0,10,0,0"><TextBlock x:Name="Status" Text="Gotowy" VerticalAlignment="Center"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Anuluj" Click="Cancel_Click"/><Button x:Name="StartButton" Content="Generuj lektora" Background="#4F8CFF" Click="Start_Click"/></StackPanel></DockPanel></Grid></Border></Grid></Window>