<Window x:Class="GeneratorLektora.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Generator Lektora"
        Width="1000" Height="760" MinWidth="700" MinHeight="560"
        Background="{DynamicResource WindowBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="28,24,28,18">
            <StackPanel>
                <TextBlock Text="Generator Lektora" FontSize="30" FontWeight="SemiBold"/>
                <TextBlock Text="Polski lektor AI  •  Supertonic 3" FontSize="14" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button x:Name="SettingsButton" HorizontalAlignment="Right" Width="148" Click="Settings_Click">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" Style="{StaticResource IconText}" Margin="0,0,8,0"/><TextBlock Text="Ustawienia"/></StackPanel>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,0,28,8">
            <StackPanel>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Plik źródłowy" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Wybierz film. Napisy SRT możesz podać ręcznie albo pozostawić puste, aby program spróbował znaleźć polskie napisy automatycznie." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,5,0,18" TextWrapping="Wrap"/>

                        <TextBlock Text="PLIK WIDEO" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="112"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="InputBox" Grid.Column="0" ToolTip="Ścieżka do filmu"/>
                            <Button Grid.Column="1" Margin="8,0,0,0" Click="InputBrowse_Click">Wybierz…</Button>
                        </Grid>

                        <TextBlock Text="PLIK WYNIKOWY MKV" Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="112"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="OutputBox" Grid.Column="0"/>
                            <Button Grid.Column="1" Margin="8,0,0,0" Click="OutputBrowse_Click">Zapisz jako…</Button>
                        </Grid>

                        <TextBlock Text="NAPISY SRT  •  OPCJONALNE" Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="112"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="SrtBox" Grid.Column="0" ToolTip="Pozostaw puste dla automatycznego wyboru napisów"/>
                            <Button Grid.Column="1" Margin="8,0,0,0" Click="SrtBrowse_Click">Wybierz…</Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Ustawienia lektora" Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="ConfigSummary" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1" Width="170" Margin="18,0,0,0" Click="Settings_Click">Zmień ustawienia</Button>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Postęp" Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="PercentText" Text="0%" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                        </Grid>
                        <TextBlock x:Name="StageText" Text="Gotowy do pracy" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,10" TextWrapping="Wrap"/>
                        <ProgressBar x:Name="ProgressBar" Minimum="0" Maximum="100" Value="0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="160"/></Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="Dziennik operacji" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Informacje techniczne" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBox Grid.Row="1" x:Name="LogBox" Margin="0,10,0,0" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12" Background="{DynamicResource SurfaceAltBrush}"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,1,0,0" Padding="28,14">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="GenerateButton" Style="{StaticResource PrimaryButton}" Width="180" Click="Generate_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" Style="{StaticResource IconText}" Margin="0,0,8,0"/><TextBlock Text="Generuj lektora"/></StackPanel>
                    </Button>
                    <Button x:Name="CancelButton" Style="{StaticResource DangerButton}" Width="92" Click="Cancel_Click" IsEnabled="False">Anuluj</Button>
                    <Button x:Name="InstallButton" Width="194" Click="Install_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" Style="{StaticResource IconText}" Margin="0,0,8,0"/><TextBlock Text="Instalacja / naprawa"/></StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" Margin="0,0,8,0"/>
                    <TextBlock x:Name="StatusText" Text="Gotowy do pracy" Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
