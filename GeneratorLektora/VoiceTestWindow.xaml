<Window x:Class="GeneratorLektora.VoiceTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Test głosu lektora" Width="680" Height="560" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBrush}"
        ShowInTaskbar="False" ResizeMode="CanResize" Closing="Window_Closing">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Test głosu lektora" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock Text="Wpisz przykładowy tekst i odsłuchaj wybrany głos Supertonic 3 przed rozpoczęciem generowania filmu."
                       Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="0,5,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,22,0,18" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Głos" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Wybierz głos, który chcesz odsłuchać." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,4,0,14"/>
                        <ComboBox x:Name="VoiceBox"/>
                        <TextBlock Text="JAKOŚĆ SYNTEZY" Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
                        <TextBlock x:Name="QualityText" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Tekst do odsłuchu" Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="CharacterCountText" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBox x:Name="TextBox" Margin="0,14,0,0" Height="150" MinHeight="120"
                                 VerticalContentAlignment="Top" TextWrapping="Wrap" AcceptsReturn="True"
                                 MaxLength="1000" TextChanged="TextBox_TextChanged"
                                 VerticalScrollBarVisibility="Auto"
                                 ToolTip="Wpisz tekst po polsku, który ma przeczytać lektor."/>
                        <TextBlock Text="Dla szybkiego testu najlepiej użyć 1–3 zdań. Synteza wykorzystuje aktualną jakość ustawioną w Ustawieniach."
                                   Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="StatusText" Text="Gotowy do testu" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ProgressBar x:Name="ProgressBar" Grid.Row="1" Margin="0,12,0,0" IsIndeterminate="True" Visibility="Collapsed"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,18,0,0">
            <Grid>
                <Button Content="Zamknij" Width="100" HorizontalAlignment="Left" Click="Close_Click"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="StopButton" Content="■  Stop" Width="100" Style="{StaticResource DangerButton}" IsEnabled="False" Click="Stop_Click"/>
                    <Button x:Name="PlayButton" Content="▶  Odtwórz" Width="125" Style="{StaticResource PrimaryButton}" Click="Play_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
