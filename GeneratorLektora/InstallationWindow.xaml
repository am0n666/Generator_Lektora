<Window x:Class="GeneratorLektora.InstallationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Instalacja komponentów" Width="760" Height="600" MinWidth="680" MinHeight="520"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="{DynamicResource WindowBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <StackPanel>
                <TextBlock Text="Instalacja komponentów" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Text="Przygotowanie środowiska dla Generatora Lektora" Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="0,5,0,0"/>
            </StackPanel>
            <TextBlock x:Name="PercentText" Text="0%" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,20,0,16" Padding="16">
            <StackPanel>
                <Grid>
                    <TextBlock x:Name="ComponentText" Text="Przygotowanie…" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock x:Name="StageText" Text="Oczekiwanie" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}"/>
                </Grid>
                <ProgressBar x:Name="ProgressBar" Height="9" Margin="0,12,0,0" Minimum="0" Maximum="100"/>
                <Grid Margin="0,8,0,0">
                    <TextBlock x:Name="SpeedText" Foreground="{DynamicResource MutedBrush}"/>
                    <TextBlock x:Name="SizeText" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}"/>
                </Grid>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}" Grid.Column="0" Padding="16">
                <StackPanel>
                    <TextBlock Text="KOMPONENTY" Style="{StaticResource FieldLabel}" Margin="0,0,0,12"/>
                    <Border x:Name="FfmpegCard" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="9" Padding="12" Margin="0,0,0,8">
                        <StackPanel><TextBlock Text="FFmpeg" FontWeight="SemiBold"/><TextBlock x:Name="FfmpegState" Text="Oczekuje" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,3,0,0"/></StackPanel>
                    </Border>
                    <Border x:Name="PythonCard" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="9" Padding="12" Margin="0,0,0,8">
                        <StackPanel><TextBlock Text="Python 3.11" FontWeight="SemiBold"/><TextBlock x:Name="PythonState" Text="Oczekuje" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,3,0,0"/></StackPanel>
                    </Border>
                    <Border x:Name="PipCard" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="9" Padding="12" Margin="0,0,0,8">
                        <StackPanel><TextBlock Text="pip" FontWeight="SemiBold"/><TextBlock x:Name="PipState" Text="Oczekuje" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,3,0,0"/></StackPanel>
                    </Border>
                    <Border x:Name="SupertonicCard" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="9" Padding="12">
                        <StackPanel><TextBlock Text="Supertonic 3" FontWeight="SemiBold"/><TextBlock x:Name="SupertonicState" Text="Oczekuje" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,3,0,0"/></StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Grid.Column="2" Padding="18">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="Aktualna operacja" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Szczegóły" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                    </Grid>
                    <TextBox Grid.Row="1" x:Name="DetailText" Margin="0,12,0,0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="{DynamicResource SurfaceAltBrush}"/>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,18,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                <TextBlock x:Name="StatusText" Text="Instalowanie…" Foreground="{DynamicResource MutedBrush}"/>
            </StackPanel>
            <Button x:Name="CloseButton" Content="Anuluj" Width="105" HorizontalAlignment="Right" Style="{StaticResource DangerButton}" Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>
